fn hex_digit(c: Char) : Option[Int] =
  if char.is_digit(c) { Some(char_to_int(c) - 48) }
  else { if c >= 'a' and c <= 'f' { Some(char_to_int(c) - 87) }
  else { if c >= 'A' and c <= 'F' { Some(char_to_int(c) - 55) }
  else { None } } }

fn hex_walk(cs: [Char], acc: Int) : Option[Int] = match cs {
  [] -> Some(acc)
  [c, ...t] -> match hex_digit(c) {
    Some(d) -> hex_walk(t, acc * 16 + d)
    None    -> None
  }
}

pub fn parse_hex(s: String) : Option[Int] = match s.drop_prefix("0x") {
  Some(rest) -> if rest.is_empty() { None } else { hex_walk(rest.chars(), 0) }
  None -> None
}
