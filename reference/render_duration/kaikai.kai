fn pad2(n: Int) : String = if n < 10 { "0#{int_to_string(n)}" } else { int_to_string(n) }

pub fn render_duration(total: Int) : String = {
  let h = total / 3600
  let m = (total % 3600) / 60
  let s = total % 60
  if h > 0 { "#{int_to_string(h)}h#{pad2(m)}m#{pad2(s)}s" }
  else { if m > 0 { "#{int_to_string(m)}m#{pad2(s)}s" } else { "#{int_to_string(s)}s" } }
}
