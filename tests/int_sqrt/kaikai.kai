fn main() : Int / Stdout = {
  let ok = int_sqrt(0) == 0 and
    int_sqrt(1) == 1 and
    int_sqrt(8) == 2 and
    int_sqrt(9) == 3 and
    int_sqrt(999999999999) == 999999 and
    int_sqrt(1000000000000) == 1000000 and
    int_sqrt(2) == 1
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
