fn main() : Int / Stdout = {
  let ok = median_floor([3,1,2]) == Some(2) and
    median_floor([4,1,3,2]) == Some(2) and
    median_floor([]) == None and
    median_floor([5]) == Some(5) and
    median_floor([-3,-4]) == Some(-3) and
    median_floor([1,1,8,8]) == Some(4)
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
