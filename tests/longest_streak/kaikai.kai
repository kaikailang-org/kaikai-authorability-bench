fn main() : Int / Stdout = {
  let ok = longest_streak([true,true,false,true,true,true]) == 3 and
    longest_streak([]) == 0 and
    longest_streak([false,false]) == 0 and
    longest_streak([true,true,true,true]) == 4 and
    longest_streak([true,false,true]) == 1
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
