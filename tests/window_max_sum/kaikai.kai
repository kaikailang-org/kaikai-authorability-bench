fn main() : Int / Stdout = {
  let ok = window_max_sum([1,2,3,4], 2) == Some(7) and
    window_max_sum([2,-1,2,3], 2) == Some(5) and
    window_max_sum([1,2], 3) == None and
    window_max_sum([5], 1) == Some(5) and
    window_max_sum([-1,-2,-3], 1) == Some(-1) and
    window_max_sum([4,4,4], 3) == Some(12)
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
