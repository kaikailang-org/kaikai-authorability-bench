fn main() : Int / Stdout = {
  let ok = running_min_balance([100,-30,-90,50]) == -20 and
    running_min_balance([5,10]) == 0 and
    running_min_balance([]) == 0 and
    running_min_balance([-1,-1,-1]) == -3 and
    running_min_balance([-5,10,-3]) == -5
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
