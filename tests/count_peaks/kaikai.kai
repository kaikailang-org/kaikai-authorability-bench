fn main() : Int / Stdout = {
  let ok = count_peaks([0,5,0,5,0]) == 2 and
    count_peaks([1,3,2]) == 1 and
    count_peaks([1,2,3]) == 0 and
    count_peaks([]) == 0 and
    count_peaks([1,2]) == 0 and
    count_peaks([1,3,3,1]) == 0
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
