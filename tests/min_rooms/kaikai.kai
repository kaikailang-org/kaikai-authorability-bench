fn mk(a: Int, b: Int) : Meeting = Meeting { start: a, finish: b }

fn chk_some(ms: [Meeting], want: Int) : Bool = match min_rooms(ms) {
  Some(v) -> v == want
  None -> false
}

fn chk_none(ms: [Meeting]) : Bool = match min_rooms(ms) {
  Some(_) -> false
  None -> true
}

fn main() : Int / Stdout = {
  let ok = chk_some([mk(0, 30), mk(5, 10), mk(15, 20)], 2) and
    chk_some([mk(1, 3), mk(3, 5)], 1) and
    chk_some([mk(7, 10), mk(2, 4)], 1) and
    chk_some([mk(1, 5), mk(2, 5), mk(3, 5)], 3) and
    chk_some([], 0) and
    chk_some([mk(4, 9)], 1) and
    chk_some([mk(1, 10), mk(2, 3), mk(4, 5), mk(6, 7)], 2) and
    chk_some([mk(0, 5), mk(5, 10), mk(5, 8)], 2) and
    chk_none([mk(5, 5)]) and
    chk_none([mk(1, 3), mk(6, 2)]) and
    chk_some([mk(-5, -1), mk(-3, 2)], 2)
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
