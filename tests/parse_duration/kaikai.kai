fn main() : Int / Stdout = {
  let ok = parse_duration("2h30m15s") == Some(9015) and
    parse_duration("90s") == Some(90) and
    parse_duration("2h") == Some(7200) and
    parse_duration("1h0m5s") == Some(3605) and
    parse_duration("90m") == Some(5400) and
    parse_duration("") == None and
    parse_duration("5x") == None and
    parse_duration("m5") == None and
    parse_duration("1s1h") == None and
    parse_duration("2h30") == None
  if ok { Stdout.print("OK") 0 } else { Stdout.print("FAIL") 1 }
}
